# ─────────────────────────────────────────────────────────────────────────────
# Outline — VPS iridia.cloud. Copiar a .env y completar.
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh      # rellena SOLO las claves vacías, deja .env 0600
#   $EDITOR .env                  # completar GOOGLE_* y SMTP_PASSWORD a mano
#
# NUNCA versionar .env (está en .gitignore). Permisos 0600.
#
# ⚠️  SECRET_KEY es irrecuperable: si se pierde, TODO el contenido cifrado de la
#     base queda inaccesible para siempre. Guardar copia en Vault (127.0.0.1:8200)
#     Y en el gestor de contraseñas personal. Backupear .env tras cada cambio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identidad pública ────────────────────────────────────────────────────────
URL=https://outline.iridia.cloud

# ── Secretos generados (scripts/gen-secrets.sh) ──────────────────────────────
SECRET_KEY=
UTILS_SECRET=
OUTLINE_POSTGRES_PASSWORD=
OUTLINE_REDIS_PASSWORD=
OUTLINE_MINIO_ROOT_PASSWORD=

# Usuario root de MinIO = access key de S3 para Outline. No es secreto por sí solo.
OUTLINE_MINIO_ROOT_USER=outline

# ── Storage (MinIO detrás de s3.iridia.cloud) ────────────────────────────────
# El hostname NO debe empezar con el nombre del bucket: si arranca con él,
# Outline descarta el endpoint custom y firma contra AWS real
# (server/storage/files/S3Storage.ts). Por eso path-style con host neutro.
AWS_S3_UPLOAD_BUCKET_URL=https://s3.iridia.cloud
AWS_S3_UPLOAD_BUCKET_NAME=outline
# "post" = presigned POST (default de Outline). MinIO lo soporta.
AWS_S3_UPLOAD_METHOD=post
# MinIO ignora la región, pero SigV4 exige que exista.
AWS_REGION=us-east-1
# 250 MB. Debe ir alineado con `request_body max_size` de los dos sites de Caddy.
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# ── Auth — Google Workspace (iridia-ai.com) ──────────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web application):
#   Authorized redirect URI:  https://outline.iridia.cloud/auth/google.callback
#   Authorized JS origin:     https://outline.iridia.cloud
# El primer login DEBE hacerse con una cuenta @iridia-ai.com: el claim `hd` es
# lo que crea el workspace. Una cuenta gmail personal no puede crearlo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mail — Resend por SMTP ───────────────────────────────────────────────────
# El usuario SMTP de Resend es literalmente "resend"; la password es la API key.
# El dominio de SMTP_FROM_EMAIL tiene que estar verificado en Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_REPLY_EMAIL=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Regla: RAM disponible / 512MB. La caja está compartida con langfuse, atlas y
# postiz — no subir sin mirar `free -h` y `docker stats` primero.
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=es_ES
LOG_LEVEL=info
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60

# ── Imagen ───────────────────────────────────────────────────────────────────
# Fase 1: imagen oficial pinneada (el fork está a diff cero de upstream v1.10.0
# y esta imagen salió de ese mismo commit).
# Fase 2 (branding propio): ghcr.io/iridia-ia/outline-service:<tag>
OUTLINE_IMAGE=outlinewiki/outline:1.10.0
